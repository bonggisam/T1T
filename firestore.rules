rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuth() && getUserData().role in ['admin', 'super_admin'];
    }

    function isSuperAdmin() {
      return isAuth() && getUserData().role == 'super_admin';
    }

    function isActive() {
      return isAuth() && getUserData().status == 'active';
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuth() && request.auth.uid == userId;
      allow read: if isAdmin();
      // Signup: just require auth + own uid (role logic handled by client + app_meta)
      allow create: if isAuth() && request.auth.uid == userId
        && (!('school' in request.resource.data) || request.resource.data.school in ['taeseong_middle', 'taeseong_high']);
      // 본인이 프로필 일부 수정 (role/status 변경 불가)
      allow update: if isAuth() && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status'])
        && (!('school' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.school in ['taeseong_middle', 'taeseong_high']);
      // 관리자 수정 — school 값 whitelist 강제
      allow update: if isAdmin()
        && (!('school' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.school in ['taeseong_middle', 'taeseong_high']);
      allow delete: if isSuperAdmin();
    }

    // 교사 명단 — 알림 대상과 @멘션에 쓰는 이름, 학교, 색만 담는다. 이메일은 넣지 않는다.
    // 승인된 교사만 읽고, 본인 줄만 쓴다. 관리자는 승인된 사람과 맞추느라 모든 줄을 고친다.
    function validDirectoryRow(data) {
      return data.keys().hasOnly(['name', 'school', 'profileColor'])
        && data.name is string && data.name.size() <= 50
        && data.school in ['taeseong_middle', 'taeseong_high']
        && (!('profileColor' in data) || (data.profileColor is string && data.profileColor.size() <= 20));
    }
    match /user_directory/{userId} {
      allow read: if isActive();
      allow create, update: if ((isActive() && request.auth.uid == userId) || isAdmin())
        && validDirectoryRow(request.resource.data);
      allow delete: if isAdmin();
    }

    // Shared events — all active users can create; edit/delete own only; admin can manage all
    // school 값 whitelist 검증 (스푸핑 방지)
    match /events/{eventId} {
      allow read: if isActive();
      allow create: if isActive()
        && request.resource.data.school in ['taeseong_middle', 'taeseong_high', 'all'];
      // UPDATE: school 변경 시 whitelist 강제 (request.resource 존재)
      allow update: if isActive()
        && (resource.data.createdBy == request.auth.uid || isAdmin())
        && (!('school' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.school in ['taeseong_middle', 'taeseong_high', 'all']);
      // 읽음 표시 — 활성 교사는 자기 읽음 표시만 남긴다. 다른 필드와 남의 표시는 바꿀 수 없다.
      allow update: if isActive()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
        && request.resource.data.readBy.diff(resource.data.get('readBy', {})).affectedKeys().hasOnly([request.auth.uid]);
      // DELETE: request.resource는 null이므로 diff() 호출 불가 — 별도 규칙
      allow delete: if isActive()
        && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // 일정 응답 — 사람마다 한 건. 본인 것만 쓰고 활성 교사는 볼 수 있다. 사유 칸은 받지 않는다.
    match /events/{eventId}/responses/{userId} {
      allow read: if isActive();
      allow create, update: if isActive() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['userId', 'name', 'status', 'respondedAt'])
        && request.resource.data.userId == userId
        && request.resource.data.status in ['attend', 'absent', 'confirm']
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 50;
      // 본인 철회. 일정을 지우기 전 정리는 일정 작성자와 관리자가 한다.
      allow delete: if isActive() && (
        request.auth.uid == userId
        || get(/databases/$(database)/documents/events/$(eventId)).data.createdBy == request.auth.uid
        || isAdmin()
      );
    }

    // 컴시간 표기와 계정 연결표 — 학교마다 문서 하나. 활성 교사는 읽고 관리자만 고친다.
    // 회의 찾기가 쓰는 이름과 표기만 담고 이메일은 넣지 않는다.
    match /comcigan_links/{school} {
      allow read: if isActive();
      allow write: if isAdmin()
        && school in ['taeseong_middle', 'taeseong_high']
        && request.resource.data.keys().hasOnly(['school', 'schoolCode', 'schoolName', 'maxGrade', 'entries', 'updatedBy', 'updatedAt'])
        && request.resource.data.school == school
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.entries is list
        && request.resource.data.entries.size() <= 300;
    }

    // 시험감독 게시판 — 부서, 교과별로 사진을 올린다. 승인된 교사가 보고 올리며, 올린 사람과 관리자가 지운다.
    // Storage를 쓰지 않아 사진 한 장을 문서 하나에 넣는다. 문서 크기 제한(1MiB) 안으로 앱이 줄여서 올린다.
    function validBoardPost(data) {
      return data.keys().hasOnly(['group', 'tab', 'title', 'school', 'images', 'createdBy', 'createdByName', 'createdAt'])
        && data.group in ['dept', 'subject']
        && data.tab is string && data.tab.size() > 0 && data.tab.size() <= 20
        && data.title is string && data.title.size() <= 60
        && data.school in ['taeseong_middle', 'taeseong_high', 'all']
        && data.images is list && data.images.size() > 0 && data.images.size() <= 20
        && data.createdByName is string && data.createdByName.size() <= 50;
    }
    match /board_posts/{postId} {
      allow read: if isActive();
      allow create: if isActive()
        && request.resource.data.createdBy == request.auth.uid
        && validBoardPost(request.resource.data);
      allow delete: if isActive()
        && (resource.data.createdBy == request.auth.uid || isAdmin());
    }
    match /board_images/{imageId} {
      // 사진은 글에 적힌 번호로 한 장씩만 읽는다. 목록으로 한꺼번에 받지 않는다.
      allow get: if isActive();
      allow create: if isActive()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasOnly(['data', 'mime', 'width', 'height', 'createdBy', 'createdAt'])
        && request.resource.data.mime in ['image/webp', 'image/jpeg', 'image/png']
        && request.resource.data.data.size() <= 1000000;
      allow delete: if isActive()
        && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // 옛 시험 감독·당직 표. 업데이트하지 않은 앱이 아직 읽는다. 앞으로 새로 쓰지 않는다.
    // 시험 감독·당직 표 — 활성 교사가 만들고, 만든 사람과 관리자가 고치거나 지운다. 활성 교사는 모두 볼 수 있다.
    function validDutyTable(data) {
      return data.keys().hasOnly(['title', 'school', 'entries', 'firstDate', 'lastDate', 'createdBy', 'createdByName', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 60
        && data.school in ['taeseong_middle', 'taeseong_high', 'all']
        && data.entries is list && data.entries.size() > 0 && data.entries.size() <= 2000
        && data.firstDate is string && data.lastDate is string
        && data.createdByName is string && data.createdByName.size() <= 50;
    }
    match /duty_tables/{tableId} {
      allow read: if isActive();
      allow create: if isActive()
        && request.resource.data.createdBy == request.auth.uid
        && validDutyTable(request.resource.data);
      allow update: if isActive()
        && (resource.data.createdBy == request.auth.uid || isAdmin())
        && request.resource.data.createdBy == resource.data.createdBy
        && validDutyTable(request.resource.data);
      allow delete: if isActive()
        && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // Personal events
    match /personal_events/{userId}/events/{eventId} {
      allow read, write: if isAuth() && request.auth.uid == userId && isActive();
    }

    // App metadata
    match /app_meta/{docId} {
      allow read: if isAuth();
      allow create: if isAuth();
      // 활성 사용자만 업데이트 가능 (NEIS 자동 동기화 시간 기록 등)
      allow update: if isActive();
    }

    // Notifications — 본인만 읽고 업데이트/삭제 가능. 생성은 active 사용자 (멘션 알림용)
    match /notifications/{userId}/items/{notificationId} {
      allow read: if isAuth() && request.auth.uid == userId;
      allow update, delete: if isAuth() && request.auth.uid == userId;
      // createdBy를 본인 uid로만 생성 가능 (스푸핑 방지)
      allow create: if isActive() && request.resource.data.createdBy == request.auth.uid;
    }

    // Event comments (subcollection) — 본인 또는 관리자 삭제 가능
    match /events/{eventId}/comments/{commentId} {
      allow read: if isActive();
      allow create: if isActive() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Todos — userId == 본인만 읽기/쓰기 가능
    match /todos/{todoId} {
      allow read: if isActive() && resource.data.userId == request.auth.uid;
      allow create: if isActive() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // 키폰 번호부 — 활성 사용자 모두 조회 가능, 관리자(admin/super_admin)만 수정
    match /keyphones/{entryId} {
      allow read: if isActive();
      allow create: if isAdmin()
        && request.resource.data.school in ['taeseong_middle', 'taeseong_high'];
      allow update: if isAdmin()
        && (!('school' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.school in ['taeseong_middle', 'taeseong_high']);
      allow delete: if isAdmin();
    }

    // 키폰 시드 동시 진입 방지용 sentinel — 관리자만
    match /keyphones_meta/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
  }
}
