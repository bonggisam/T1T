+function deobfuscateSource(source) {
+  return source.replace(
+    /\/\* hour-obfuscated-v2 \*\/[\s\S]*?\}\)\((\[\[[\s\S]*?\]\]),\s*(\d+)\)\s*;/g,
+    (whole, chunks, key) => {
+      try {
+        let decoded = '';
+        for (const [isLiteral, text] of JSON.parse(chunks)) {
+          if (isLiteral) {
+            decoded += text;
+            continue;
+          }
+          for (let j = 0; j < text.length; j += 4) {
+            decoded += String.fromCharCode(
+              parseInt(text.substr(j, 4), 16) ^ ((Number(key) + (j / 4) * 13) & 255),
+            );
+          }
+        }
+        return decoded;
+      } catch (e) {
+        return whole;
+      }
+    },
+  );
+}
